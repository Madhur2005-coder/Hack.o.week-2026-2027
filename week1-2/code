from fastapi import FastAPI, Depends, HTTPException, status
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
from sqlalchemy.orm import Session
from typing import List

import models
import schemas
import crud
from database import engine, get_db

# Create database tables
models.Base.metadata.create_all(bind=engine)

app = FastAPI(
    title="Library Management System API",
    description="A simple REST API for managing books, members, and borrowings in a library.",
    version="1.0.0"
)

app.mount("/static", StaticFiles(directory="static"), name="static")

# --- BOOKS ENDPOINTS ---

@app.post("/books", response_model=schemas.Book, status_code=status.HTTP_201_CREATED, tags=["Books"])
def create_book(book: schemas.BookCreate, db: Session = Depends(get_db)):
    db_book = crud.get_book_by_isbn(db, book.isbn)
    if db_book:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Book with ISBN {book.isbn} already exists."
        )
    return crud.create_book(db=db, book=book)

@app.get("/books", response_model=List[schemas.Book], tags=["Books"])
def read_books(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):
    return crud.get_books(db, skip=skip, limit=limit)

@app.get("/books/{book_id}", response_model=schemas.Book, tags=["Books"])
def read_book(book_id: int, db: Session = Depends(get_db)):
    db_book = crud.get_book(db, book_id=book_id)
    if db_book is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Book with ID {book_id} not found."
        )
    return db_book

@app.put("/books/{book_id}", response_model=schemas.Book, tags=["Books"])
def update_book(book_id: int, book: schemas.BookUpdate, db: Session = Depends(get_db)):
    # Check if updating ISBN to an existing ISBN (other than this book)
    if book.isbn:
        db_book_isbn = crud.get_book_by_isbn(db, book.isbn)
        if db_book_isbn and db_book_isbn.id != book_id:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"ISBN {book.isbn} is already assigned to another book."
            )
            
    db_book = crud.update_book(db=db, book_id=book_id, book=book)
    if db_book is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Book with ID {book_id} not found."
        )
    return db_book

@app.delete("/books/{book_id}", status_code=status.HTTP_204_NO_CONTENT, tags=["Books"])
def delete_book(book_id: int, db: Session = Depends(get_db)):
    db_book = crud.delete_book(db=db, book_id=book_id)
    if db_book is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Book with ID {book_id} not found."
        )
    return None


# --- MEMBERS ENDPOINTS ---

@app.post("/members", response_model=schemas.Member, status_code=status.HTTP_201_CREATED, tags=["Members"])
def create_member(member: schemas.MemberCreate, db: Session = Depends(get_db)):
    db_member = crud.get_member_by_email(db, member.email)
    if db_member:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Member with email {member.email} already exists."
        )
    return crud.create_member(db=db, member=member)

@app.get("/members", response_model=List[schemas.Member], tags=["Members"])
def read_members(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):
    return crud.get_members(db, skip=skip, limit=limit)

@app.get("/members/{member_id}", response_model=schemas.Member, tags=["Members"])
def read_member(member_id: int, db: Session = Depends(get_db)):
    db_member = crud.get_member(db, member_id=member_id)
    if db_member is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Member with ID {member_id} not found."
        )
    return db_member

@app.put("/members/{member_id}", response_model=schemas.Member, tags=["Members"])
def update_member(member_id: int, member: schemas.MemberUpdate, db: Session = Depends(get_db)):
    # Check if email is already taken
    if member.email:
        db_member_email = crud.get_member_by_email(db, member.email)
        if db_member_email and db_member_email.id != member_id:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Email {member.email} is already in use by another member."
            )
            
    db_member = crud.update_member(db=db, member_id=member_id, member=member)
    if db_member is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Member with ID {member_id} not found."
        )
    return db_member

@app.delete("/members/{member_id}", status_code=status.HTTP_204_NO_CONTENT, tags=["Members"])
def delete_member(member_id: int, db: Session = Depends(get_db)):
    db_member = crud.delete_member(db=db, member_id=member_id)
    if db_member is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Member with ID {member_id} not found."
        )
    return None


# --- BORROW/RETURN ENDPOINTS ---

@app.post("/borrow", response_model=schemas.BorrowRecord, status_code=status.HTTP_201_CREATED, tags=["Transactions"])
def borrow_book_endpoint(request: schemas.BorrowRequest, db: Session = Depends(get_db)):
    record, error_msg = crud.borrow_book(db, book_id=request.book_id, member_id=request.member_id)
    if error_msg:
        if "not found" in error_msg.lower():
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=error_msg)
        else:
            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=error_msg)
    return record

@app.post("/return/{borrow_record_id}", response_model=schemas.BorrowRecord, tags=["Transactions"])
def return_book_endpoint(borrow_record_id: int, db: Session = Depends(get_db)):
    record, error_msg = crud.return_book(db, borrow_record_id=borrow_record_id)
    if error_msg:
        if "not found" in error_msg.lower():
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail=error_msg)
        else:
            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=error_msg)
    return record

@app.get("/borrows/active", response_model=List[schemas.ActiveBorrowResponse], tags=["Transactions"])
def read_active_borrows(db: Session = Depends(get_db)):
    return crud.get_active_borrows(db)

@app.get("/", tags=["Root"])
def root():
    return FileResponse("static/index.html")

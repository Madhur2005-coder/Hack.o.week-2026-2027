                </div>
                <div class="code-content"><pre><span class="keyword">import</span> numpy <span class="keyword">as</span> np

<span class="comment"># Array creation & vectorized ops</span>
a = np.array([<span class="number">1</span>, <span class="number">2</span>, <span class="number">3</span>, <span class="number">4</span>])
b = np.array([<span class="number">10</span>, <span class="number">20</span>, <span class="number">30</span>, <span class="number">40</span>])
<span class="builtin">print</span>(<span class="string">"a + b  ="</span>, a + b)
<span class="builtin">print</span>(<span class="string">"a * b  ="</span>, a * b)
<span class="builtin">print</span>(<span class="string">"dot    ="</span>, np.dot(a, b))

<span class="comment"># Broadcasting</span>
matrix = np.arange(<span class="number">12</span>).reshape(<span class="number">3</span>, <span class="number">4</span>)
row    = np.array([<span class="number">1</span>, <span class="number">0</span>, <span class="number">-1</span>, <span class="number">2</span>])
<span class="builtin">print</span>(<span class="string">"\\nMatrix + row (broadcast):"</span>)
<span class="builtin">print</span>(matrix + row)</pre></div>
              </div>
              <div class="output-block">
                <div class="output-label">▶ Output</div>
                <div class="output-content">a + b  = [11 22 33 44]
a * b  = [ 10  40  90 160]
dot    = 300

Matrix + row (broadcast):
[[ 1  1  1  5]
 [ 5  5  5  9]
 [ 9  9  9 13]]</div>
              </div>

        </div>

        <!-- Vectors -->
        <div class="tab-content active" id="tab-la-vectors">
          <div class="instruction-box">
            <span class="instruction-icon">✋</span>
            Drag the arrow tips to change the vectors. Watch the dot product update in real time.
          </div>
          <div class="grid-2">
            <div class="canvas-container">
              <canvas id="vector-canvas" width="500" height="500"></canvas>

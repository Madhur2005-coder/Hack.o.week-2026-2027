                  </div>
                  <div class="control-group" style="flex-direction:column;align-items:stretch;">
                    <span class="control-label">a₁₂</span>
                    <input type="range" id="m12" min="-3" max="3" step="0.1" value="0" />
                    <span class="control-value" id="m12-val">0.0</span>
                  </div>
                  <div class="control-group" style="flex-direction:column;align-items:stretch;">
                    <span class="control-label">a₂₁</span>
                    <input type="range" id="m21" min="-3" max="3" step="0.1" value="0" />
                    <span class="control-value" id="m21-val">0.0</span>
                  </div>
                  <div class="control-group" style="flex-direction:column;align-items:stretch;">
                    <span class="control-label">a₂₂</span>
                    <input type="range" id="m22" min="-3" max="3" step="0.1" value="1" />
                    <span class="control-value" id="m22-val">1.0</span>
                  </div>
                </div>

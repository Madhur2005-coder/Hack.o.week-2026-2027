              <canvas id="matrix-canvas" width="500" height="500"></canvas>
            </div>
            <div>
              <div class="card">
                <div class="card-title">🔢 Transformation Matrix</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-sm);margin:var(--space-md) 0;">
                  <div class="control-group" style="flex-direction:column;align-items:stretch;">
                    <span class="control-label">a₁₁</span>
                    <input type="range" id="m11" min="-3" max="3" step="0.1" value="1" />

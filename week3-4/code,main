            </div>
            <div class="control-group">
              <span class="control-label">Function</span>
              <select id="gd-func">
                <option value="bowl">Bowl: x² + y²</option>
                <option value="saddle">Rosenbrock</option>
                <option value="rastrigin">Rastrigin</option>
              </select>
            </div>
            <button class="btn btn-accent" id="gd-run">▶ Run Descent</button>

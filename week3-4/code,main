        <!-- Functions & OOP -->
        <div class="tab-content active" id="tab-py-functions">
          <div class="grid-2">
            <div>
              <div class="code-block">
                <div class="code-header">
                  <div class="code-dots"><span class="code-dot"></span><span class="code-dot"></span><span class="code-dot"></span></div>
                  <span class="code-filename">functions.py</span>
                </div>
                <div class="code-content"><pre><span class="comment"># List & dict comprehensions</span>
<span class="keyword">squares</span> = [x**<span class="number">2</span> <span class="keyword">for</span> x <span class="keyword">in</span> <span class="builtin">range</span>(<span class="number">10</span>)]
<span class="keyword">even_sq</span> = {x: x**<span class="number">2</span> <span class="keyword">for</span> x <span class="keyword">in</span> <span class="builtin">range</span>(<span class="number">10</span>) <span class="keyword">if</span> x % <span class="number">2</span> == <span class="number">0</span>}

<span class="comment"># Higher-order function</span>
<span class="keyword">def</span> <span class="function">apply_twice</span>(<span class="param">func</span>, <span class="param">value</span>):
    <span class="string">"""Apply a function twice to a value."""</span>
    <span class="keyword">return</span> func(func(value))

<span class="keyword">result</span> = apply_twice(<span class="keyword">lambda</span> x: x + <span class="number">3</span>, <span class="number">7</span>)
<span class="builtin">print</span>(result)  <span class="comment"># 13</span></pre></div>
              </div>
              <div class="output-block">
                <div class="output-label">▶ Output</div>
                <div class="output-content">squares → [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]
even_sq → {0: 0, 2: 4, 4: 16, 6: 36, 8: 64}
result  → 13</div>
              </div>
            </div>
            <div>
              <div class="code-block">
                <div class="code-header">
                  <div class="code-dots"><span class="code-dot"></span><span class="code-dot"></span><span class="code-dot"></span></div>
                  <span class="code-filename">oop.py</span>
                </div>
                <div class="code-content"><pre><span class="keyword">class</span> <span class="class-name">Model</span>:
    <span class="string">"""Base class for ML models."""</span>
    <span class="keyword">def</span> <span class="function">__init__</span>(<span class="param">self</span>, <span class="param">name</span>):
        <span class="param">self</span>.name = name
        <span class="param">self</span>.is_trained = <span class="number">False</span>

    <span class="keyword">def</span> <span class="function">train</span>(<span class="param">self</span>, <span class="param">X</span>, <span class="param">y</span>):
        <span class="keyword">raise</span> <span class="class-name">NotImplementedError</span>

<span class="keyword">class</span> <span class="class-name">LinearRegressor</span>(<span class="class-name">Model</span>):
    <span class="keyword">def</span> <span class="function">__init__</span>(<span class="param">self</span>):
        <span class="builtin">super</span>().__init__(<span class="string">"LinearRegressor"</span>)
        <span class="param">self</span>.weights = <span class="number">None</span>

    <span class="keyword">def</span> <span class="function">train</span>(<span class="param">self</span>, <span class="param">X</span>, <span class="param">y</span>):
        <span class="param">self</span>.weights = <span class="string">"...computed..."</span>
        <span class="param">self</span>.is_trained = <span class="number">True</span>

<span class="keyword">model</span> = LinearRegressor()
<span class="builtin">print</span>(model.name, model.is_trained)</pre></div>
              </div>
